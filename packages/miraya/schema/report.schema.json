{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "durationMs": {
      "type": "number"
    },
    "config": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "w": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "h": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "pair",
            "rtl-only"
          ]
        }
      },
      "required": [
        "hash",
        "viewport",
        "mode"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "routeErrors": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "findings": {
          "type": "object",
          "properties": {
            "error": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "warn": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "info": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "error",
            "warn",
            "info"
          ],
          "additionalProperties": false
        },
        "new": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "baselined": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "fixed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "routes",
        "routeErrors",
        "findings",
        "new",
        "baselined",
        "fixed"
      ],
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "durationMs": {
            "type": "number"
          },
          "pairing": {
            "type": "object",
            "properties": {
              "testid": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "path": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "heuristic": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "pathRejected": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "unmatched": {
                "type": "object",
                "properties": {
                  "ltr": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "rtl": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "ltr",
                  "rtl"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "testid",
              "path",
              "heuristic",
              "unmatched"
            ],
            "additionalProperties": false
          },
          "skippedRules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screenshots": {
            "type": "object",
            "properties": {
              "ltr": {
                "type": "string"
              },
              "rtl": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "frames": {
                "type": "object",
                "properties": {
                  "ltr": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "w"
                    ],
                    "additionalProperties": false
                  },
                  "rtl": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "w"
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "rtl",
              "truncated"
            ],
            "additionalProperties": false
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warn",
                    "error"
                  ]
                },
                "route": {
                  "type": "string"
                },
                "selector": {
                  "type": "string"
                },
                "boxes": {
                  "type": "object",
                  "properties": {
                    "ltr": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number"
                        },
                        "h": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "additionalProperties": false
                    },
                    "rtl": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number"
                        },
                        "h": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "message": {
                  "type": "string"
                },
                "docsUrl": {
                  "type": "string"
                },
                "evidence": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": [
                      "number",
                      "string",
                      "boolean"
                    ]
                  }
                },
                "match": {
                  "type": "string",
                  "enum": [
                    "testid",
                    "path",
                    "heuristic"
                  ]
                },
                "sourceHint": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "new",
                    "baselined"
                  ]
                },
                "possiblyMoved": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "rule",
                "severity",
                "route",
                "selector",
                "boxes",
                "message",
                "docsUrl",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "timeout",
                    "redirected",
                    "rule-crashed",
                    "cdp-unavailable",
                    "failed"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                },
                "finalUrl": {
                  "type": "string"
                },
                "stack": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "route",
          "status",
          "durationMs",
          "pairing",
          "skippedRules",
          "notes",
          "screenshots",
          "findings",
          "errors"
        ],
        "additionalProperties": false
      }
    },
    "fixed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "route": {
            "type": "string"
          }
        },
        "required": [
          "fingerprint",
          "rule",
          "route"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "startedAt",
    "durationMs",
    "config",
    "summary",
    "routes",
    "fixed"
  ],
  "additionalProperties": false
}
