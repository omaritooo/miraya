{
  "name": "@miraya/playwright",
  "version": "0.2.0",
  "description": "Playwright helpers for Miraya: assert that a page has no right-to-left bugs.",
  "license": "MIT",
  "author": "omaritooo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omaritooo/miraya.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/omaritooo/miraya/tree/main/packages/playwright#readme",
  "bugs": {
    "url": "https://github.com/omaritooo/miraya/issues"
  },
  "keywords": [
    "rtl",
    "right-to-left",
    "arabic",
    "i18n",
    "l10n",
    "bidi",
    "accessibility",
    "playwright",
    "testing",
    "css"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.19.43",
    "tsup": "8.5.1"
  },
  "dependencies": {
    "@miraya/cli": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
